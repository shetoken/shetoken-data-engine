# SHEtoken WEI News Agent — Environment Variables
# Copy to .env and fill in your values

# Gmail (required for weekly report)
# Use an App Password — NOT your regular Gmail password
# Setup: myaccount.google.com > Security > 2FA > App passwords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
REPORT_TO_EMAIL=your@gmail.com

# Newsletter subscribers (comma-separated, get clean version without internal data)
NEWSLETTER_SUBSCRIBERS=investor1@example.com,ngo_partner@example.com

# NGO partners (comma-separated, get NGO-focused version)
NEWSLETTER_NGOS=kudumbashree@kerala.gov.in,jeevika@bihar.gov.in

# Google Sheets (optional — for live dashboard)
GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json

# Ollama (only change if not running on default port)
OLLAMA_HOST=http://localhost:11434

# Cloud Run (only needed for GCP deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── YouTube Data API (free, 10K searches/day) ─────────────────────────────────
# Get key at: console.cloud.google.com → Enable YouTube Data API v3 → Create Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Reddit API (free) ─────────────────────────────────────────────────────────
# Create app at: reddit.com/prefs/apps → script app
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# ── Twitter/X API (free tier = write only, $100/mo = search too) ─────────────
# developer.twitter.com → Create Project → Create App → Keys & Tokens
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# ── Instagram Graph API (business account required) ───────────────────────────
# developers.facebook.com → Create App → Instagram Graph API
IG_ACCESS_TOKEN=your_long_lived_access_token
IG_BUSINESS_ID=your_instagram_business_account_id

# ── ImgBB (free image hosting for Instagram posts) ───────────────────────────
# imgbb.com → API → Get free API key
IMGBB_API_KEY=your_imgbb_api_key
