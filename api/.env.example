
# ── API Analytics ─────────────────────────────────────────────────────────────
# memory   = in-memory only (resets on redeploy, fine for dev)
# supabase = permanent storage in Supabase free tier (recommended)
# file     = local JSONL file (simple, works anywhere)
ANALYTICS_BACKEND=memory

# If using Supabase backend:
# 1. Create free account at supabase.com
# 2. Create a table called api_calls:
#    endpoint text, status_code int, duration_ms float,
#    called_at timestamptz, week text, date text
# 3. Copy URL and anon key from project settings
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
